{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashenfell",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "RAID_ROOMS", "class_name": "RaidRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RaidRoom"] }],
  "observability": { "enabled": true }
}
